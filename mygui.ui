       <widget class="QComboBox" name="cmb_mol_method">
        <property name="geometry">
         <rect>
          <x>80</x>
          <y>10</y>
          <width>171</width>
          <height>41</height>
         </rect>
        </property>
        <property name="font">
         <font>
          <family>Arial</family>
