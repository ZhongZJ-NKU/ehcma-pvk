     <widget class="QPlainTextEdit" name="txt_status_message">
      <property name="geometry">
       <rect>
        <x>40</x>
        <y>10</y>
        <width>531</width>
        <height>41</height>
       </rect>
      </property>
      <property name="font">
       <font>
        <family>Arial</family>
        <pointsize>12</pointsize>
        <italic>false</italic>
        <bold>false</bold>
       </font>
      </property>
      <property name="styleSheet">
       <string notr="true">/* ==================== QPlainTextEdit / QTextEdit ==================== */
/* ==================== QPlainTextEdit / QTextEdit ==================== */
QPlainTextEdit,
QTextEdit
{
	font: 12pt &quot;Arial&quot;;
	background-color: rgba(66, 79, 104, 1);
	border: 1px solid transparent;
	border-radius: 10px;
	color: rgb(255, 255, 255);
	padding: 6px 20px;                     /* 文本四周留出舒适内边距 */
	selection-background-color: #3478e8;
	selection-color: #ffffff;
}


QPlainTextEdit:hover,
QTextEdit:hover
{	
	border: 1px solid #3478e8;}

QPlainTextEdit:focus,
QTextEdit:focus
{
	border: 1px solid #3478e8;
}

QPlainTextEdit:disabled,
QTextEdit:disabled
{
	background-color: #f6f7f9;
	color: #9498a0;
	border: 1px solid transparent;
}


/* ==================== 深色滚动条（与整体风格统一） ==================== */
QPlainTextEdit QScrollBar:vertical,
QTextEdit QScrollBar:vertical
{
	background: transparent;
	width: 10px;
	margin: 4px 2px 4px 0px;
	border: none;
}

QPlainTextEdit QScrollBar::handle:vertical,
QTextEdit QScrollBar::handle:vertical
{
	background: rgb(90, 105, 135);
	min-height: 24px;
	border-radius: 4px;
}

QPlainTextEdit QScrollBar::handle:vertical:hover,
QTextEdit QScrollBar::handle:vertical:hover
{
	background: rgb(120, 138, 172);
}

QPlainTextEdit QScrollBar::handle:vertical:pressed,
QTextEdit QScrollBar::handle:vertical:pressed
{
	background: #3478e8;
}

/* 去掉上下箭头和页步进区域（现代风格通常隐藏） */
QPlainTextEdit QScrollBar::add-line:vertical,
QPlainTextEdit QScrollBar::sub-line:vertical,
QTextEdit QScrollBar::add-line:vertical,
QTextEdit QScrollBar::sub-line:vertical
{
	height: 0px;
	background: transparent;
}

QPlainTextEdit QScrollBar::add-page:vertical,
QPlainTextEdit QScrollBar::sub-page:vertical,
QTextEdit QScrollBar::add-page:vertical,
QTextEdit QScrollBar::sub-page:vertical
{
	background: transparent;
}

/* 水平滚动条 */
QPlainTextEdit QScrollBar:horizontal,
QTextEdit QScrollBar:horizontal
{
	background: transparent;
	height: 10px;
	margin: 0px 4px 2px 4px;
	border: none;
}

QPlainTextEdit QScrollBar::handle:horizontal,
QTextEdit QScrollBar::handle:horizontal
{
	background: rgb(90, 105, 135);
	min-width: 24px;
	border-radius: 4px;
}

QPlainTextEdit QScrollBar::handle:horizontal:hover,
QTextEdit QScrollBar::handle:horizontal:hover
{
	background: rgb(120, 138, 172);
}

QPlainTextEdit QScrollBar::handle:horizontal:pressed,
QTextEdit QScrollBar::handle:horizontal:pressed
{
	background: #3478e8;
}

QPlainTextEdit QScrollBar::add-line:horizontal,
QPlainTextEdit QScrollBar::sub-line:horizontal,
QTextEdit QScrollBar::add-line:horizontal,
QTextEdit QScrollBar::sub-line:horizontal
{
	width: 0px;
	background: transparent;
}

QPlainTextEdit QScrollBar::add-page:horizontal,
QPlainTextEdit QScrollBar::sub-page:horizontal,
QTextEdit QScrollBar::add-page:horizontal,
QTextEdit QScrollBar::sub-page:horizontal
{
	background: transparent;
}</string>
