QScrollArea QScrollBar::add-page:vertical       { background: none; }

QScrollArea QScrollBar:horizontal
{
    height: 10px;
    background-color: #f2f2f2;
    border-radius: 4px;
    margin: 0px 2px;
}
QScrollArea QScrollBar::handle:horizontal
{
    background: #94989e;
    border-radius: 4px;
    min-width: 28px;
    margin: 1px;
}
