        <property name="styleSheet">
         <string notr="true">/* ==================== QLineEdit ==================== */
QLineEdit
{
	font: 12pt &quot;Arial&quot;;
	background-color: rgba(66, 79, 104, 1);
	border: 1px solid transparent;   /* 与 SpinBox 保持一致，避免尺寸跳动 */
	border-radius: 10px;
	font-size: 14px;
	color: rgb(255, 255, 255);
	padding-left: 0px;             /* 文本左侧留出舒适边距 */
	padding-right: 0px;
	min-height: 20px;
	selection-background-color: #3478e8;
	selection-color: #ffffff;
}

QLineEdit:hover
{
	background-color: rgb(74, 88, 115);   /* 悬浮时略微变亮 */
	border: 1px solid #3478e8;

}

QLineEdit:focus
{
	border: 1px solid #3478e8;
}

QLineEdit:disabled
{
	background-color: #f6f7f9;
	color: #9498a0;
	border: 1px solid transparent;
}

QLineEdit[echoMode=&quot;2&quot;]   /* 密码框也保持一致 */
{
	lineedit-password-character: 9679;
}


/* ==================== QComboBox ==================== */
QComboBox
{
	font: 12pt &quot;Arial&quot;;
	background-color: rgba(66, 79, 104, 1);
	border: 1px solid transparent;
	border-radius: 10px;
	font-size: 14px;
	color: rgb(255, 255, 255);
	padding-left: 0px;
	padding-right: 0px;            /* 右侧给下拉箭头留空间 */
	min-height: 20px;
}

QComboBox:hover
{
	background-color: rgb(74, 88, 115);   /* 悬浮时略微变亮 */
	border: 1px solid #3478e8;}

QComboBox:focus
{
	border: 1px solid #3478e8;
}

QComboBox:disabled
{
	background-color: #f6f7f9;
	color: #9498a0;
	border: 1px solid transparent;
}

/* 下拉箭头区域（右侧按钮） */
QComboBox::drop-down
{
	subcontrol-origin: padding;
	subcontrol-position: center right;
	width: 28px;
	border: none;
	border-top-right-radius: 10px;
	border-bottom-right-radius: 10px;
	background: transparent;
}

QComboBox::drop-down:hover
{
	background-color: rgb(37, 52, 81);
}

QComboBox::drop-down:pressed
{
	background-color: rgb(204, 204, 204);
}

/* 下拉箭头图标 */
QComboBox::down-arrow
{
	image: url(:/icons/down_arrow.svg);
	width: 14px;
	height: 14px;
}

QComboBox::down-arrow:disabled
{
	image: url(:/icons/down_arrow.svg);
	opacity: 0.4;
}

/* 可编辑 ComboBox 的文本区 */
QComboBox QAbstractItemView,
QComboBox QLineEdit
{
	background-color: rgba(66, 79, 104, 1);
	color: rgb(255, 255, 255);
	border-radius: 10px;
	selection-background-color: #3478e8;
	selection-color: #ffffff;
}

/* 下拉列表弹出框 */
QComboBox QAbstractItemView
{
	background-color: rgba(66, 79, 104, 1);
	color: rgb(255, 255, 255);
	border: 1px solid #3478e8;
	border-radius: 8px;
	selection-background-color: #3478e8;
	selection-color: #ffffff;
	outline: none;
	padding: 4px;
}

QComboBox QAbstractItemView::item
{
	min-height: 24px;
	padding-left: 8px;
	border-radius: 6px;
}

QComboBox QAbstractItemView::item:hover
{
	background-color: rgb(37, 52, 81);
}

QComboBox QAbstractItemView::item:selected
{
	background-color: #3478e8;
	color: #ffffff;
}
/* ==================== 深色滚动条（与 QPlainTextEdit 统一） ==================== */
QComboBox QScrollBar:vertical {
    width:10px;
    background: rgba(35, 41, 54, 0.35);
    border-radius:4px;
    margin:2px 0px;
}
QComboBox QScrollBar::handle:vertical {
    background: rgba(150, 165, 190, 0.55);
    border-radius:4px;
    min-height:28px;
    margin:1px;
}
QComboBox QScrollBar::handle:vertical:hover {
    background: rgba(120, 170, 230, 0.85);  
}
QComboBox QScrollBar::handle:vertical:pressed {
    background: rgba(70, 130, 210, 1.0);   
}

QComboBox QScrollBar::sub-line:vertical,
QComboBox QScrollBar::add-line:vertical {
    height:0px;
background: none;
}
QComboBox QScrollBar::sub-page:vertical,
QComboBox QScrollBar::add-page:vertical {
    background:none;
}

QComboBox QScrollBar:horizontal {
    height:10px;
    background: rgba(35, 41, 54, 0.35);
    border-radius:4px;
    margin:0px 2px;
}
QComboBox QScrollBar::handle:horizontal {
    background: rgba(150, 165, 190, 0.55);
    border-radius:4px;
    min-width:28px;
    margin:1px;
}
QComboBox QScrollBar::handle:horizontal:hover {
    background: rgba(120, 170, 230, 0.85);
}
QComboBox QScrollBar::handle:horizontal:pressed {
    background: rgba(70, 130, 210, 1.0);
}

QComboBox QScrollBar::sub-line:horizontal,
QComboBox QScrollBar::add-line:horizontal {
    width:0px;
    background: none;

}
QComboBox QScrollBar::sub-page:horizontal,
QComboBox QScrollBar::add-page:horizontal {
    background:none;
}
</string>
