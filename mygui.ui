       <widget class="QComboBox" name="cmb_ml_metric">
        <property name="geometry">
         <rect>
          <x>870</x>
          <y>10</y>
          <width>81</width>
          <height>41</height>
         </rect>
        </property>
        <property name="font">
         <font>
          <family>Arial</family>
          <pointsize>-1</pointsize>
          <italic>false</italic>
          <bold>false</bold>
          <hintingpreference>PreferDefaultHinting</hintingpreference>
