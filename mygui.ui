        <string notr="true">QSpinBox,
QDoubleSpinBox
{
	font: 12pt &quot;Arial&quot;;
    background-color: rgba(66, 79, 104, 1);
border: 0px solid #e2e4e8;
border-radius:10px;
font-size:14px;
color:;
	color: rgb(255, 255, 255);
padding-left:5px;
}
QSpinBox::up-button,
QDoubleSpinBox::up-button
{
subcontrol-origin: border;
subcontrol-position: top right;
border-radius:10px;
width: 25px;
height: 20px;
}

QSpinBox::down-button,
QDoubleSpinBox::down-button
{
subcontrol-origin: border;
subcontrol-position: bottom right;
border-radius:10px;
width: 25px;
height: 20px;
}

QSpinBox:hover,
QDoubleSpinBox:hover
{
	background-color: rgb(74, 88, 115);   /* 悬浮时略微变亮 */
	border: 1px solid #3478e8;
}

QSpinBox:focus,
QDoubleSpinBox:focus
{
border:1px solid #3478e8;
}
QSpinBox:disabled,
QDoubleSpinBox:disabled
{
background-color:#f6f7f9;
color:#9498a0;
}

QSpinBox::up-arrow,
QDoubleSpinBox::up-arrow
{
image:url(:/icons/up_arrow.svg);
width:18px;
height:18px;

}

QSpinBox::down-arrow,
QDoubleSpinBox::down-arrow
{
image:url(:/icons/down_arrow.svg);
width:18px;
height:18px;
}

QSpinBox::up-button:hover,
QDoubleSpinBox::up-button:hover
{
background-color:rgb(37, 52, 81);
border-radius:10px;

}
QSpinBox::up-button:pressed,
QDoubleSpinBox::up-button:pressed
{
background-color:rgb(204, 204, 204);
border-radius:10px;

}
QSpinBox::up-button:disabled,
QDoubleSpinBox::up-button:disabled
{
background-color:transparent;
border-radius:10px;

}

QSpinBox::down-button:hover,
QDoubleSpinBox::down-button:hover
{
background-color:rgb(37, 52, 81);
border-radius:10px;

}
QSpinBox::down-button:pressed,
QDoubleSpinBox::down-button:pressed
{
background-color:rgb(204, 204, 204);
border-radius:10px;

}
QSpinBox::down-button:disabled,
QDoubleSpinBox::down-button:disabled
{
background-color:transparent;
border-radius:10px;

}
