       <property name="styleSheet">
        <string notr="true">/* ==================== QTableWidget ==================== */
QTableWidget
{
    background-color: rgba(35, 41, 54, 0.5);
    alternate-background-color: rgba(45, 52, 68, 0.45);
    border: 1px solid transparent;
    border-radius: 18px;
    padding: 4px;
    font-family: &quot;Arial&quot;;
    font-size: 14px;
    color: rgb(255, 255, 255);
    gridline-color: rgba(120, 140, 170, 0.25);
    outline: none;
}

QTableWidget::item
{
    padding: 4px 8px;
    border: none;
    color: rgb(255, 255, 255);
}

QTableWidget::item:hover
{
    background-color: rgba(74, 88, 115, 0.55);
}

QTableWidget::item:selected
{
    background-color: #3478e8;
    color: #ffffff;
}

QTableWidget::item:focus
{
    border: 1px solid #3478e8;
}

/* ==================== 表头 ==================== */
QTableWidget QHeaderView
{
    background-color: transparent;
    border: none;
}

QHeaderView::section
{
    background-color: rgba(66, 79, 104, 0.9);
    color: rgb(255, 255, 255);
    border: none;
    border-right: 1px solid rgba(120, 140, 170, 0.25);
    border-bottom: 1px solid rgba(120, 140, 170, 0.25);
    padding: 6px 8px;
    font-family: &quot;Arial&quot;;
    font-size: 14px;
    font-weight: normal;
}

QHeaderView::section:hover
{
    background-color: rgb(74, 88, 115);
}

QHeaderView::section:checked
{
    background-color: #3478e8;
    color: #ffffff;
}

/* 左上角那个交叉按钮 */
QTableCornerButton::section
{
    background-color: rgba(66, 79, 104, 0.9);
    border: none;
    border-top-left-radius: 12px;
}

/* ==================== 表格内 QLineEdit（编辑时） ==================== */
QTableWidget QLineEdit
{
    background-color: rgba(35, 41, 54, 0.9);
    color: #ffffff;
    border: 1px solid #3478e8;
    border-radius: 6px;
    padding: 2px 6px;
    selection-background-color: #3478e8;
    selection-color: #ffffff;
}

/* ==================== 表格内 QComboBox（cellWidget 时） ==================== */
QTableWidget QComboBox
{
    background-color: rgba(66, 79, 104, 1);
    color: #ffffff;
    border: 1px solid transparent;
    border-radius: 6px;
    padding-left: 6px;
    min-height: 20px;
}

QTableWidget QComboBox:hover
{
    background-color: rgb(74, 88, 115);
    border: 1px solid #3478e8;
}

QTableWidget QComboBox::drop-down
{
    border: none;
    width: 20px;
    background: transparent;
}

/* ==================== 表格内 QSpinBox（cellWidget 时） ==================== */
QTableWidget QSpinBox
{
    background-color: rgba(66, 79, 104, 1);
    color: #ffffff;
    border: 1px solid transparent;
    border-radius: 6px;
    padding-left: 6px;
    min-height: 20px;
}

QTableWidget QSpinBox:hover
{
    background-color: rgb(74, 88, 115);
    border: 1px solid #3478e8;
}

/* ==================== 纵向滚动条（与 QGraphicsView 一致） ==================== */
QTableWidget QScrollBar:vertical
{
    width: 10px;
    background: rgba(35, 41, 54, 0.35);
    border-radius: 4px;
    margin: 2px 0px;
}

QTableWidget QScrollBar::handle:vertical
{
    background: rgba(150, 165, 190, 0.55);
    border-radius: 4px;
    min-height: 28px;
    margin: 1px;
}

QTableWidget QScrollBar::handle:vertical:hover
{
    background: rgba(120, 170, 230, 0.85);
}

QTableWidget QScrollBar::handle:vertical:pressed
{
    background: rgba(70, 130, 210, 1.0);
}

QTableWidget QScrollBar::sub-line:vertical,
QTableWidget QScrollBar::add-line:vertical
{
    height: 0px;
    background: none;
}

QTableWidget QScrollBar::sub-page:vertical,
QTableWidget QScrollBar::add-page:vertical
{
    background: none;
}

/* ==================== 横向滚动条（与 QGraphicsView 一致） ==================== */
QTableWidget QScrollBar:horizontal
{
    height: 10px;
    background: rgba(35, 41, 54, 0.35);
    border-radius: 4px;
    margin: 0px 2px;
}

QTableWidget QScrollBar::handle:horizontal
{
    background: rgba(150, 165, 190, 0.55);
    border-radius: 4px;
    min-width: 28px;
    margin: 1px;
}

QTableWidget QScrollBar::handle:horizontal:hover
{
    background: rgba(120, 170, 230, 0.85);
}

QTableWidget QScrollBar::handle:horizontal:pressed
{
    background: rgba(70, 130, 210, 1.0);
}

QTableWidget QScrollBar::sub-line:horizontal,
QTableWidget QScrollBar::add-line:horizontal
{
    width: 0px;
    background: none;
}

QTableWidget QScrollBar::sub-page:horizontal,
QTableWidget QScrollBar::add-page:horizontal
{
    background: none;
}

/* ==================== 滚动条交叉角 ==================== */
QTableWidget QScrollBar::corner
{
    background: rgba(35, 41, 54, 0.35);
    border: none;
}</string>
