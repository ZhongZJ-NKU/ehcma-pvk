      <widget class="QCheckBox" name="chk_eval_gam">
       <property name="geometry">
        <rect>
         <x>770</x>
         <y>10</y>
         <width>71</width>
         <height>21</height>
        </rect>
       </property>
       <property name="font">
        <font>
         <family>Arial</family>
         <pointsize>-1</pointsize>
