        <property name="styleSheet">
         <string notr="true">/* ==================== QListWidget ==================== */
QListWidget
{
	font: 12pt &quot;Arial&quot;;
	font-size: 12px;
	background-color: rgba(66, 79, 104, 1);
	border: 1px solid transparent;
	border-radius: 10px;
	color: rgb(255, 255, 255);
    padding: 4px;                     /* ← 0 改 4px */
	outline: none;                    /* 去掉聚焦时的虚线框 */
	selection-background-color: transparent;  /* item 选中样式由 ::item 单独控制 */
	selection-color: rgb(255, 255, 255);
}

QListWidget:hover
{
	border: 1px solid #3478e8;
}



QListWidget:focus
{
	border: 1px solid #3478e8;
}

QListWidget:disabled
{
	background-color: #f6f7f9;
	color: #9498a0;
	border: 1px solid transparent;
}


/* ==================== 每个 item ==================== */
QListWidget::item
{
	background-color: transparent;
	color: rgb(255, 255, 255);
	border-radius: 6px;               /* 比外层圆角小一点更协调 */
	padding: 0px 0px;
	margin: 0px 0px;
	min-height: 20px;
}

/* 悬浮 */
QListWidget::item:hover
{
	background-color: rgb(37, 52, 81);   /* 与你按钮悬浮一致 */
}

/* 选中 */
/*QListWidget::item:selected
{
	background-color: #3478e8;
	color: #ffffff;} */

/* 选中 + 悬浮：略深一点的蓝 */
/* QListWidget::item:selected:hover
{
	background-color: #2d6ad4;
	color: #ffffff;
} */

/* 禁用 */
QListWidget::item:disabled
{
	color: #9498a0;
}


/* ==================== item 里的复选框指示器 ==================== */
/* listWidget_algorithms 每一项都带 checkbox，这里让它们和 QCheckBox 保持一致 */
QListWidget::indicator
{
	width: 16px;
	height: 16px;
	border: 1px solid rgb(120, 138, 172);
	border-radius: 4px;
	background-color: rgba(66, 79, 104, 1);
}

QListWidget::indicator:hover
{
	border: 1px solid #3478e8;
	background-color: rgb(74, 88, 115);
}

QListWidget::indicator:checked
{
	border: 1px solid #3478e8;
	image: url(:/icons/check.svg);    /* 复用你刚编译进去的 check.svg */
}

QListWidget::indicator:checked:hover
{
	background-color: #2d6ad4;
	border: 1px solid #2d6ad4;
}

QListWidget::indicator:checked:pressed
{
	background-color: #2159bd;
	border: 1px solid #2159bd;
}

QListWidget::indicator:disabled
{
	background-color: #f6f7f9;
	border: 1px solid #d0d3d8;
}


/* ============ 纵向滚动条 ============ */
QListWidget QScrollBar:vertical {
    width: 10px;
    background: rgba(35, 41, 54, 0.35);
    border-radius: 4px;
    margin: 2px 0px;
}
QListWidget QScrollBar::handle:vertical {
    background: rgba(150, 165, 190, 0.55);
    border-radius: 4px;
    min-height: 28px;
    margin: 1px;
}
QListWidget QScrollBar::handle:vertical:hover {
    background: rgba(120, 170, 230, 0.85);
}
QListWidget QScrollBar::handle:vertical:pressed {
    background: rgba(70, 130, 210, 1.0);
}
QListWidget QScrollBar::sub-line:vertical,
QListWidget QScrollBar::add-line:vertical {
    height: 0px;
    background: none;
}
QListWidget QScrollBar::sub-page:vertical,
QListWidget QScrollBar::add-page:vertical {
    background: none;
}

/* ============ 横向滚动条 ============ */
QListWidget QScrollBar:horizontal {
    height: 10px;
    background: rgba(35, 41, 54, 0.35);
    border-radius: 4px;
    margin: 0px 2px;
}
QListWidget QScrollBar::handle:horizontal {
    background: rgba(150, 165, 190, 0.55);
    border-radius: 4px;
    min-width: 28px;
    margin: 1px;
}
QListWidget QScrollBar::handle:horizontal:hover {
    background: rgba(120, 170, 230, 0.85);
}
QListWidget QScrollBar::handle:horizontal:pressed {
    background: rgba(70, 130, 210, 1.0);
}
QListWidget QScrollBar::sub-line:horizontal,
QListWidget QScrollBar::add-line:horizontal {
    width: 0px;
    background: none;
}
QListWidget QScrollBar::sub-page:horizontal,
QListWidget QScrollBar::add-page:horizontal {
    background: none;
}</string>
        </property>
