        <property name="styleSheet">
         <string notr="true">/* ==================== QCheckBox ==================== */
QCheckBox
{
	font: 12pt &quot;Arial&quot;;
	font-size: 14px;
	color: rgb(255, 255, 255);
	spacing: 8px;                 /* 文字与小方框的间距 */
	background: transparent;      /* 复选框本身不要背景，否则会是个大色块 */
	padding: 2px 0px;
}

QCheckBox:hover
{
	color: #93C5FD;               /* 悬浮时文字变浅蓝 */
}

QCheckBox:focus
{
	color: #3478e8;               /* 聚焦时文字变品牌蓝 */
}

QCheckBox:disabled
{
	color: #9498a0;
}


/* ==================== 指示器（小方框） ==================== */
QCheckBox::indicator
{
	width: 18px;
	height: 18px;
	border: 1px solid rgb(120, 138, 172);   /* 深色背景上用略亮边框才看得见 */
	border-radius: 5px;
	background-color: rgba(66, 79, 104, 1);
}

QCheckBox::indicator:hover
{
	border: 1px solid #3478e8;
	background-color: rgb(74, 88, 115);
}

QCheckBox::indicator:pressed
{
	background-color: rgb(37, 52, 81);
}

/* 勾选状态：填充蓝色 + 显示对勾图标 */
QCheckBox::indicator:checked
{
	border: 1px solid #3478e8;
	image: url(:/icons/check.svg);
}

QCheckBox::indicator:checked:hover
{
	background-color: #2d6ad4;
	border: 1px solid #2d6ad4;
}

QCheckBox::indicator:checked:pressed
{
	background-color: #2159bd;
	border: 1px solid #2159bd;
}

/* 半选状态（三态复选框用得到） */
QCheckBox::indicator:indeterminate
{
	background-color: #3478e8;
	border: 1px solid #3478e8;
	image: url(:/icons/indeterminate.svg);
}

/* 禁用状态 */
QCheckBox::indicator:disabled
{
	background-color: #f6f7f9;
	border: 1px solid #d0d3d8;
}

QCheckBox::indicator:checked:disabled
{
	background-color: #c8ccd2;
	border: 1px solid #c8ccd2;
	image: url(:/icons/check.svg);
}</string>
        </property>
