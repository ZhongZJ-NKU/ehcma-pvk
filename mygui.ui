    font-size: 14px;
    color: rgb(255, 255, 255);
}

QScrollArea &gt; QWidget &gt; QWidget
{
    background: transparent;
    border-radius: 18px;
}

QScrollArea QScrollBar:vertical
{
    width: 10px;
    background-color:rgba(35, 41, 54, 0.5);
    border-radius: 4px;
    margin: 2px 0px;
}
