       <property name="styleSheet">
        <string notr="true">/* ============================================================
   QGraphicsView —— 白底风格
   ============================================================ */

QGraphicsView
{
    background-color: rgba(255, 255, 255, 1);
    border: 1px solid transparent;
    border-top-left-radius: 18px;
    border-top-right-radius: 18px;
    border-bottom-right-radius: 0px;
    border-bottom-left-radius: 0px;

    /* 如果不想让滚动条离边框有 4px 空隙，就删掉这一行 */
    padding: 4px;

    font: 12pt &quot;Arial&quot;;
    font-size: 14px;
    color: rgb(40, 40, 40);      /* 白底上用深色文字 */
}


/* ==================== 纵向滚动条 ==================== */

QGraphicsView QScrollBar:vertical
{
    width: 10px;
    background: none;            /* 轨道透明 —— 只写一次 */
    border: none;
    border-radius: 4px;
    margin: 2px 0px;
}

QGraphicsView QScrollBar::handle:vertical
{
    background: #BFC6D1;
    border-radius: 4px;
    min-height: 28px;
    margin: 1px;
}

QGraphicsView QScrollBar::handle:vertical:hover
{
    background: #8FA3C0;
}

QGraphicsView QScrollBar::handle:vertical:pressed
{
    background: #3478E8;
}

QGraphicsView QScrollBar::sub-line:vertical,
QGraphicsView QScrollBar::add-line:vertical
{
    height: 0px;
    background: none;
    border: none;
}

QGraphicsView QScrollBar::sub-page:vertical,
QGraphicsView QScrollBar::add-page:vertical
{
    background: none;
    border: none;
}


/* ==================== 横向滚动条 ==================== */

QGraphicsView QScrollBar:horizontal
{
    height: 10px;
    background: none;            /* 轨道透明 —— 只写一次 */
    border: none;
    border-radius: 4px;
    margin: 0px 2px;
}

QGraphicsView QScrollBar::handle:horizontal
{
    background: #BFC6D1;
    border-radius: 4px;
    min-width: 28px;
    margin: 1px;
}

QGraphicsView QScrollBar::handle:horizontal:hover
{
    background: #8FA3C0;
}

QGraphicsView QScrollBar::handle:horizontal:pressed
{
    background: #3478E8;
}

QGraphicsView QScrollBar::sub-line:horizontal,
QGraphicsView QScrollBar::add-line:horizontal
{
    width: 0px;
    background: none;
    border: none;
}

QGraphicsView QScrollBar::sub-page:horizontal,
QGraphicsView QScrollBar::add-page:horizontal
{
    background: none;
    border: none;
}


/* ==================== 滚动条交叉角 ==================== */

QGraphicsView QScrollBar::corner
{
    background: none;
    border: none;
}</string>
