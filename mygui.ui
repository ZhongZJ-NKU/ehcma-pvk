        <string notr="true">QGraphicsView
{
    background-color: rgba(35, 41, 54, 0.5);
    border: 1px solid transparent;
    border-radius: 18px;
    padding: 4px;                        /* 图像四周留白，避免贴边 */
    font: 12pt &quot;Arial&quot;;
    font-size: 14px;
    color: rgb(255, 255, 255);
}

QGraphicsView {
    background-color: rgba(35, 41, 54, 0.5);
    border: 1px solid transparent;
    border-radius: 18px;
    font: 12pt &quot;Arial&quot;;
    font-size: 14px;
    color: rgb(255, 255, 255);
}

/* ============ 纵向滚动条 ============ */
QGraphicsView QScrollBar:vertical {
    width: 10px;
    background: rgba(35, 41, 54, 0.35);
    border-radius: 4px;
    margin: 2px 0px;
}
QGraphicsView QScrollBar::handle:vertical {
    background: rgba(150, 165, 190, 0.55);
    border-radius: 4px;
    min-height: 28px;
    margin: 1px;
}
QGraphicsView QScrollBar::handle:vertical:hover {
    background: rgba(120, 170, 230, 0.85);
}
QGraphicsView QScrollBar::handle:vertical:pressed {
    background: rgba(70, 130, 210, 1.0);
}

QGraphicsView QScrollBar::sub-line:vertical,
QGraphicsView QScrollBar::add-line:vertical {
    height: 0px;
    background: none;
}
QGraphicsView QScrollBar::sub-page:vertical,
QGraphicsView QScrollBar::add-page:vertical {
    background: none;
}

/* ============ 横向滚动条 ============ */
QGraphicsView QScrollBar:horizontal {
    height: 10px;
    background: rgba(35, 41, 54, 0.35);
    border-radius: 4px;
    margin: 0px 2px;
}
QGraphicsView QScrollBar::handle:horizontal {
    background: rgba(150, 165, 190, 0.55);
    border-radius: 4px;
    min-width: 28px;
    margin: 1px;
}
QGraphicsView QScrollBar::handle:horizontal:hover {
    background: rgba(120, 170, 230, 0.85);
}
QGraphicsView QScrollBar::handle:horizontal:pressed {
    background: rgba(70, 130, 210, 1.0);
}

QGraphicsView QScrollBar::sub-line:horizontal,
QGraphicsView QScrollBar::add-line:horizontal {
    width: 0px;
    background: none;
}
QGraphicsView QScrollBar::sub-page:horizontal,
QGraphicsView QScrollBar::add-page:horizontal {
    background: none;
}</string>
